# Defaults download the original public models into the persistent cache.
LOCAL_ENGINE_GIGAAM_MODEL=v3_ctc
LOCAL_ENGINE_PUNCTUATION_MODEL=kontur-ai/sbert_punc_case_ru
LOCAL_ENGINE_PREPROCESSING=raw
LOCAL_ENGINE_MAX_INFLIGHT_REQUESTS=3
# Unload resident models after this many idle seconds; 0 keeps them loaded.
LOCAL_ENGINE_MODEL_IDLE_SECONDS=300

# Direct Python default: mps on native Apple Silicon macOS, cuda elsewhere.
# Valid devices: mps, cuda, cpu. CPU is explicit opt-in, never automatic fallback.
# Start-Mac.sh requires mps; Install-Mac.sh sets it in a newly created .env.
# LOCAL_ENGINE_DEVICE=mps

# For private artifacts, place them under ./models and configure their runtime paths.
# Docker example:
# LOCAL_ENGINE_GIGAAM_MODEL=/models/my-gigaam.ckpt
# LOCAL_ENGINE_PUNCTUATION_MODEL=/models/my-punctuation-model
# Windows example:
# LOCAL_ENGINE_GIGAAM_MODEL=C:\models\my-gigaam.ckpt
# LOCAL_ENGINE_PUNCTUATION_MODEL=C:\models\my-punctuation-model
# Native macOS example:
# LOCAL_ENGINE_GIGAAM_MODEL=/Users/you/models/my-gigaam.ckpt
# LOCAL_ENGINE_PUNCTUATION_MODEL=/Users/you/models/my-punctuation-model
