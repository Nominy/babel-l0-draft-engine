# Defaults download the original public models into the persistent cache.
LOCAL_ENGINE_GIGAAM_MODEL=v3_ctc
LOCAL_ENGINE_PUNCTUATION_MODEL=kontur-ai/sbert_punc_case_ru
LOCAL_ENGINE_PREPROCESSING=raw

# For private artifacts, place them under ./models and use container paths instead:
# LOCAL_ENGINE_GIGAAM_MODEL=/models/my-gigaam.ckpt
# LOCAL_ENGINE_PUNCTUATION_MODEL=/models/my-punctuation-model
